# Copy to .env and fill in. Never commit .env.
FALKORDB_HOST_PORT=56379
POSTGRES_HOST_PORT=55432
FALKORDB_TEST_HOST_PORT=56390
POSTGRES_USER=graphathon
POSTGRES_PASSWORD=change-me

# App settings (read by apps/api/app/config.py)
FALKORDB_URL=redis://127.0.0.1:56379
# Ephemeral FalkorDB used only by pytest (no persistence).
TEST_FALKORDB_URL=redis://127.0.0.1:56390
GRAPH_NAME=graphathon
POSTGRES_DSN=postgresql://graphathon:change-me@127.0.0.1:55432/graphathon
TENANT_ALLOWLIST=nova
DEFAULT_TENANT=nova
DEFAULT_ENV=prod

# Hybrid retrieval (Phase 3): 'ollama' or 'none' (graph + keyword only).
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RETRIEVAL_ALLOWED_CLASSIFICATIONS=public,internal

# LLM (Phase 4). "stub" is the default; "ollama" for local dev.
LLM_PROVIDER=stub
LLM_TIMEOUT_S=90
LLM_FALLBACK_TO_STUB=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Phase 4: in-process worker that runs queued investigations (LangGraph + Postgres checkpoints).
ORCHESTRATOR_ENABLED=true
MAX_INVESTIGATION_REVISIONS=2
BRANCH_TIMEOUT_S=20

# Phase 6: demo-only toggles for two graph edges (GET/PUT /api/demo/controls). Leave off outside demos.
DEMO_CONTROLS_ENABLED=false
