{
  "name": "graphathon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Graphathon Incident Investigator: demo dashboard over synthetic NovaCommerce data",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
