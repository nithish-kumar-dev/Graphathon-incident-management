      {
        "id": "nova.chunk.adr_031.0",
        "claim_type": "context",
        "document_id": "nova.doc.adr_031",
        "document_title": "ADR-031 Payment rollbacks require payments lead approval",
        "document_classification": "internal",
        "ordinal": 0,
        "source_ref": "synthetic://wiki/adr/031#chunk-0",
        "text_excerpt": "Status: active since 2026-06-01. Supersedes ADR-017.\n\nDecision: a rollback of the payment service requires approval from the payments lead (role approver:payment). Ledger reconciliation must be paused before the rollback starts and resumed after error rates return to baseline.\n\nRationale: two rollbacks under ADR-017 left the ledger with duplicate settlement entries.",
        "graph_links": [
